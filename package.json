{
  "name": "api-security-lab-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=high",
    "security:local-boundary": "node scripts/verify-local-lab-boundary.mjs",
    "security:repository": "node scripts/verify-repository-safety.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:cloudflare:built": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "wrangler deploy",
    "dry-run:cloudflare": "wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "4.111.0"
  }
}
