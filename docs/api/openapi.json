{
  "openapi": "3.1.0",
  "info": {
    "title": "API Security Lab Platform API",
    "version": "0.1.0",
    "description": "Local-first API specification for comparing vulnerable and secure API examples. Vulnerable routes are local-only and must not be publicly deployed."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "secure",
      "description": "Secure API examples and support endpoints"
    },
    {
      "name": "vulnerable",
      "description": "Local-only vulnerable API examples and support endpoints"
    }
  ],
  "paths": {
    "/api/secure/health": {
      "get": {
        "tags": ["secure"],
        "summary": "Secure API health endpoint",
        "responses": {
          "200": {
            "description": "Secure route status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/health": {
      "get": {
        "tags": ["vulnerable"],
        "summary": "Local-only vulnerable API health endpoint",
        "responses": {
          "200": {
            "description": "Vulnerable route status when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/orders/{orderId}": {
      "get": {
        "tags": ["vulnerable"],
        "summary": "Local-only BOLA vulnerable order lookup",
        "description": "Fetches an order by ID only to demonstrate missing object ownership checks. This route is local-only and must not be publicly deployed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Order data returned without ownership verification when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secure/orders/{orderId}": {
      "get": {
        "tags": ["secure"],
        "summary": "BOLA secure order lookup with ownership check",
        "description": "Fetches an order only when the demo user owns the requested resource.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          },
          {
            "$ref": "#/components/parameters/UserIdRequired"
          }
        ],
        "responses": {
          "200": {
            "description": "Order data returned after ownership verification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID or user ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Demo user does not own the requested order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/auth/session": {
      "post": {
        "tags": ["vulnerable"],
        "summary": "Local-only weak token validation example",
        "description": "Accepts a local demo token by ID only to demonstrate missing signature, expiration, revocation, and permission checks. This route is local-only and must not be publicly deployed.",
        "requestBody": {
          "$ref": "#/components/requestBodies/AuthSessionRequest"
        },
        "responses": {
          "200": {
            "description": "Session accepted with weak validation when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid demo token request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Demo token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secure/auth/session": {
      "post": {
        "tags": ["secure"],
        "summary": "Secure token validation example",
        "description": "Validates demo token signature state, expiration, revocation state, and required permission before creating a session.",
        "requestBody": {
          "$ref": "#/components/requestBodies/AuthSessionRequest"
        },
        "responses": {
          "200": {
            "description": "Session accepted after secure validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid demo token request body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Demo token failed signature, expiration, or revocation validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Demo token does not include the required permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Demo token not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secure/lab-samples": {
      "get": {
        "tags": ["secure"],
        "summary": "List safe local sample users and resources",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/ResourceType"
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered sample data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/lab-samples": {
      "get": {
        "tags": ["vulnerable"],
        "summary": "List local-only vulnerable-route sample data",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          },
          {
            "$ref": "#/components/parameters/ResourceType"
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered sample data when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "AuthSessionRequest": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthSessionRequest"
            },
            "example": {
              "tokenId": "demo-token-expired-admin",
              "requiredPermission": "admin:read"
            }
          }
        }
      }
    },
    "parameters": {
      "UserId": {
        "name": "userId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "pattern": "^user-demo-[a-z-]+$"
        }
      },
      "UserIdRequired": {
        "name": "userId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^user-demo-[a-z-]+$"
        }
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^order-demo-[0-9]{3}$"
        }
      },
      "ResourceType": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["order", "profile", "report"]
        }
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["ok", "error", "meta"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      },
      "ApiMeta": {
        "type": "object",
        "required": ["routeType"],
        "properties": {
          "routeType": {
            "type": "string",
            "enum": ["secure", "vulnerable"]
          },
          "localOnly": {
            "type": "boolean"
          }
        }
      },
      "AuthSessionRequest": {
        "type": "object",
        "required": ["tokenId"],
        "properties": {
          "tokenId": {
            "type": "string",
            "pattern": "^demo-token-[a-z-]+$"
          },
          "requiredPermission": {
            "type": "string",
            "enum": ["orders:read", "admin:read"],
            "default": "orders:read"
          }
        }
      }
    }
  }
}
