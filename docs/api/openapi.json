{
  "openapi": "3.1.0",
  "info": {
    "title": "API Security Lab Platform API",
    "version": "0.1.0",
    "description": "Local-first API specification for comparing vulnerable and secure API examples. Vulnerable routes are local-only, disabled by default, require explicit LAB_MODE=local in a non-production loopback environment, and must not be publicly deployed. JSON request bodies require application/json and are limited to 16 KiB."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "secure",
      "description": "Secure API examples and support endpoints"
    },
    {
      "name": "vulnerable",
      "description": "Local-only vulnerable API examples and support endpoints"
    }
  ],
  "paths": {
    "/api/secure/health": {
      "get": {
        "tags": ["secure"],
        "summary": "Secure API health endpoint",
        "responses": {
          "200": {
            "description": "Secure route status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/health": {
      "get": {
        "tags": ["vulnerable"],
        "summary": "Local-only vulnerable API health endpoint",
        "responses": {
          "200": {
            "description": "Vulnerable route status when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/vulnerable/orders/{orderId}": {
      "get": {
        "tags": ["vulnerable"],
        "summary": "Local-only BOLA vulnerable order lookup",
        "description": "Fetches an order by ID only to demonstrate missing object ownership checks. This route is local-only and must not be publicly deployed.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          }
        ],
        "responses": {
          "200": {
            "description": "Order data returned without ownership verification when local mode is enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Vulnerable route disabled outside local non-production mode",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secure/orders/{orderId}": {
      "get": {
        "tags": ["secure"],
        "summary": "BOLA secure order lookup with ownership check",
        "description": "Fetches an order only when the demo user owns the requested resource.",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          },
          {
            "$ref": "#/components/parameters/UserIdRequired"
          }
        ],
        "responses": {
          "200": {
            "description": "Order data returned after ownership verification",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiSuccess"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order ID or user ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Demo user does not own the requested order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
