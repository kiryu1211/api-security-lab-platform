  "components": {
    "requestBodies": {
      "AuthSessionRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthSessionRequest"
            },
            "example": {
              "tokenId": "demo-token-expired-admin",
              "requiredPermission": "admin:read"
            }
          }
        }
      },
      "AdminInvitationRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AdminInvitationRequest"
            },
            "example": {
              "actorUserId": "user-demo-alice",
              "targetEmailAlias": "analyst.demo",
              "requestedRole": "admin"
            }
          }
        }
      },
      "ProfileUpdateRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ProfileUpdateRequest" },
            "example": {
              "displayLabel": "changed-label",
              "ownerId": "user-demo-bob",
              "role": "reviewer"
            }
          }
        }
      },
      "FetchUrlRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/FetchUrlRequest" },
            "example": { "url": "https://api.example.test/resource" }
          }
        }
      },
      "SecurityConfigAuditRequest": {
        "required": true,
        "description": "Requires application/json. requestedOrigin is a synthetic audit scenario value, not the browser authorization origin. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SecurityConfigAuditRequest"
            },
            "example": {
              "requestedOrigin": "https://untrusted.example",
              "includeDebugDetails": true
            }
          }
        }
      },
      "BusinessFlowReservationRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/BusinessFlowReservationRequest"
            },
            "example": {
              "userId": "user-demo-alice",
              "productId": "product-demo-001",
              "quantity": 4,
              "flowStep": "direct-checkout"
            }
          }
        }
      },
      "ThirdPartyProfileImportRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ThirdPartyProfileImportRequest"
            },
            "example": {
              "providerResponseId": "partner-response-redirect-admin",
              "expectedProvider": "trusted-profile-service"
            }
          }
        }
      },
      "ApiInventoryOperationRequest": {
        "required": true,
        "description": "Requires application/json. The shared parser returns 400 for invalid JSON, 413 above 16 KiB, and 415 for unsupported media types.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiInventoryOperationRequest"
            },
            "example": {
              "endpointId": "legacy-token-reset-v1",
              "requestedEnvironment": "production"
            }
          }
        }
      }
    },
    "parameters": {
      "UserId": {
        "name": "userId",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": [
            "user-demo-alice",
            "user-demo-bob",
            "user-demo-reviewer",
            "user-demo-admin"
          ]
        }
      },
      "UserIdRequired": {
        "name": "userId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "user-demo-alice",
            "user-demo-bob",
            "user-demo-reviewer",
            "user-demo-admin"
          ]
        }
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^order-demo-[0-9]{3}$"
        }
      },
      "ResourceType": {
        "name": "resourceType",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "enum": ["order", "profile", "report"]
        }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "default": "demo"
        }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Maximum requests permitted in the current demo window.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "RateLimitRemaining": {
        "description": "Requests remaining in the current demo window.",
        "schema": { "type": "integer", "minimum": 0 }
      },
      "RateLimitReset": {
        "description": "Seconds until the current demo window resets.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retrying the request.",
        "schema": { "type": "integer", "minimum": 1 }
      },
      "ContentSecurityPolicy": {
        "description": "Restrictive policy applied to protected diagnostic responses.",
        "schema": {
          "type": "string",
          "const": "default-src 'none'; frame-ancestors 'none'"
        }
      },
      "CrossOriginResourcePolicy": {
        "description": "Restricts protected diagnostic responses to the same origin.",
        "schema": { "type": "string", "const": "same-origin" }
      },
      "VaryOrigin": {
        "description": "Indicates that the response policy depends on the Origin header.",
        "schema": { "type": "string", "const": "Origin" }
      }
    },
    "responses": {
      "PayloadTooLarge": {
        "description": "The JSON request body exceeds the 16 KiB limit.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type is not application/json with an optional charset.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" }
          }
        }
      }
    },
    "schemas": {
      "ApiSuccess": {
        "type": "object",
        "required": ["ok", "data", "meta"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "object"
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["ok", "error", "meta"],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ApiMeta"
          }
        }
      },
      "ApiMeta": {
        "type": "object",
        "required": ["routeType"],
        "properties": {
          "routeType": {
            "type": "string",
            "enum": ["secure", "vulnerable"]
          },
          "localOnly": {
            "type": "boolean"
          }
        }
      },
      "AuthSessionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tokenId"],
        "properties": {
          "tokenId": {
            "type": "string",
            "pattern": "^demo-token-[a-z-]+$"
          },
          "requiredPermission": {
            "type": "string",
            "enum": ["orders:read", "admin:read"],
            "default": "orders:read"
          }
        }
      },
      "AdminInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetEmailAlias", "requestedRole"],
        "properties": {
          "actorUserId": {
            "type": "string",
            "enum": [
              "user-demo-alice",
              "user-demo-bob",
              "user-demo-reviewer",
              "user-demo-admin"
            ],
            "default": "user-demo-alice"
          },
          "targetEmailAlias": {
            "type": "string",
            "enum": ["analyst.demo", "owner.demo"]
          },
          "requestedRole": {
            "type": "string",
            "enum": ["learner", "reviewer", "admin"]
          }
        }
      },
      "ProfileUpdateRequest": {
        "type": "object",
        "properties": {
          "displayLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "notificationsEnabled": { "type": "boolean" },
          "ownerId": {
            "type": "string",
            "enum": [
              "user-demo-alice",
              "user-demo-bob",
              "user-demo-reviewer",
              "user-demo-admin"
            ]
          },
          "role": { "type": "string", "enum": ["learner", "reviewer"] }
        }
      },
      "FetchUrlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" }
        }
      },
      "SecurityConfigAuditRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestedOrigin"],
        "properties": {
          "requestedOrigin": {
            "type": "string",
            "enum": ["https://lab.example.test", "https://untrusted.example"]
          },
          "includeDebugDetails": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "BusinessFlowReservationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "quantity", "flowStep"],
        "properties": {
          "userId": {
            "type": "string",
            "enum": [
              "user-demo-alice",
              "user-demo-bob",
              "user-demo-reviewer",
              "user-demo-admin"
            ],
            "default": "user-demo-alice"
          },
          "productId": {
            "type": "string",
            "pattern": "^product-demo-[0-9]{3}$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "flowStep": {
            "type": "string",
            "enum": ["cart-confirmed", "direct-checkout"]
          }
        }
      },
      "ThirdPartyProfileImportRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerResponseId", "expectedProvider"],
        "properties": {
          "providerResponseId": {
            "type": "string",
            "enum": [
              "partner-response-safe-profile",
              "partner-response-redirect-admin"
            ]
          },
          "expectedProvider": {
            "type": "string",
            "enum": ["trusted-profile-service"]
          }
        }
      },
      "ApiInventoryOperationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["endpointId", "requestedEnvironment"],
        "properties": {
          "endpointId": {
            "type": "string",
            "enum": ["legacy-token-reset-v1", "current-token-reset-v2"]
          },
          "requestedEnvironment": {
            "type": "string",
            "enum": ["production", "staging", "development"]
          }
        }
      }
    }
  }
}
